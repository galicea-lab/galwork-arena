# szablon przetwarzany przez wbudowany entrypoint obrazu
# nginx:*-alpine (envsubst na /etc/nginx/templates/*.template przy starcie
# kontenera) - podstawia ${HUB_UPSTREAM} ze zmiennej środowiskowej
# kontenera (docker-compose.yml -> .env). Zmienne nginx ($uri, $host...)
# nie są środowiskowe, więc envsubst ich nie dotyka.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API galwork-hub pod tym samym originem - src/api/client.ts woła
    # względne '/v1/wf/...', gdy NEXT_PUBLIC_API_URL jest puste (produkcja).
    location /v1/ {
        proxy_pass ${HUB_UPSTREAM}/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # JW 2026-10-29: edytory BPMN/formularzy (server/bpmn-files.mjs) nie
    # przechodzą przez ten kontener - ścieżkę /bpmn-files/ obsługuje nginx
    # hosta (galwork_arena.conf, z hasłem), proxując do serwisu bpmn-files
    # z docker-compose.yml. NEXT_PUBLIC_BPMN_FILES_URL musi być ustawione
    # (puste = wywołania na /api/... areny i 404). Patrz src/configs/config.ts.

    # `output: 'export'` + trailingSlash:true -> pliki *.../index.html.
    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
}
